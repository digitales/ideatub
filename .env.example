APP_NAME=IdeaTub
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (PostgreSQL with pgvector)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ideatub
DB_USERNAME=
DB_PASSWORD=

# OpenRouter (required for embeddings and metadata extraction; server-only)
OPENROUTER_API_KEY=
# Optional: override embedding/metadata models
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_MAX_INPUT_CHARS=24000
# OPENROUTER_EMBEDDING_TIMEOUT_SECONDS=45
# OPENROUTER_EMBEDDING_CONNECT_TIMEOUT_SECONDS=10
# OPENROUTER_EMBEDDING_CHARS_PER_TOKEN=2.0
# OPENROUTER_EMBEDDING_TOKEN_SAFETY_MARGIN=0.75
# OPENROUTER_METADATA_MODEL=openai/gpt-4o-mini
# OPENROUTER_METADATA_TIMEOUT_SECONDS=45
# OPENROUTER_CHAT_TIMEOUT_SECONDS=60
# OPENROUTER_CHAT_CONNECT_TIMEOUT_SECONDS=15
# OPENROUTER_CHAT_RETRY_TIMES=2
# OPENROUTER_CHAT_RETRY_SLEEP_MS=250

# MCP auth: optional legacy single shared key; prefer per-user keys from ideatub:create-mcp-keys
# MCP_ACCESS_KEY=

# Streamable HTTP (remote MCP clients): session TTL and comma-separated extra allowed Origin hosts
# MCP_SESSION_TTL_SECONDS=86400
# MCP_STREAMABLE_ALLOWED_HOSTS=
# MCP_LOG_OAUTH_FAILURES=false
# MCP_DEBUG_AUTH=false
# MCP_LOG_TOOL_CALLS=false
# If a CDN strips Authorization, use a Transform Rule to copy the value to X-Access-Token (we read that header too).

# OAuth MCP (ChatGPT connector — "Sign in with IdeaTub")
# OAUTH_MCP_ENABLED=true
# OAUTH_MCP_ISSUER="${APP_URL}"
# OAUTH_MCP_RESOURCE="${APP_URL}/api/mcp"
# Keys: locally run `php artisan ideatub:oauth-mcp-keys` (storage/app/oauth-mcp-*.pem).
# On Laravel Cloud / ephemeral disk, set base64 PEM (no newlines in the value):
# OAUTH_MCP_PRIVATE_KEY_B64=
# OAUTH_MCP_PUBLIC_KEY_B64=
OAUTH_MCP_ACCESS_TOKEN_TTL=3600
OAUTH_MCP_REFRESH_TOKEN_TTL=2592000
OAUTH_MCP_REFRESH_TOKEN_ABSOLUTE_LIFETIME=7776000

# Evernote mirror (Phase 3; optional — sync skipped if token empty)
# EVERNOTE_ACCESS_TOKEN=
# Notebook mapping: type/tag → notebook GUID (set only the keys you use)
# EVERNOTE_NOTEBOOK_GUID_DEFAULT=
# EVERNOTE_NOTEBOOK_GUID_IDEA=
# EVERNOTE_NOTEBOOK_GUID_TASK=

# Jira integration (optional): set JIRA_ENABLED=false to hide Jira from the UI and MCP
# JIRA_ENABLED=true
# JIRA_SYNC_DAYS=14
# JIRA_SCHEDULED_SYNC_DAYS=1

# Postmark inbound: webhook URL = {APP_URL}/webhooks/postmark/inbound/{POSTMARK_INBOUND_WEBHOOK_SECRET}
# POSTMARK_INBOUND_WEBHOOK_SECRET=
# Optional: address to show in settings (e.g. capture@in.yourdomain.com)
# POSTMARK_INBOUND_CAPTURE_ADDRESS=
# Optional: log incoming email payloads (sanitized) to storage/logs/laravel.log — set to true to debug, false when done
# POSTMARK_INBOUND_LOG_EMAILS=false


# Email sender policy (Postmark + Fastmail): sender-rule settings and policy-first ingestion (off by default)
EMAIL_SENDER_POLICY_ENABLED=false

# Fastmail/JMAP mailbox sync
MAIL_SYNC_ENABLED=true
MAIL_SYNC_BACKFILL_BATCH_SIZE=50
MAIL_SYNC_INCREMENTAL_BATCH_SIZE=25

# Inbox generation (scheduled / ideatub:generate-inbox-items): max new items per user per run (see config/inbox.php)
# INBOX_MAX_NEW_PER_RUN=5

# Queue (sync for no queue; redis when using Evernote sync or other jobs)
QUEUE_CONNECTION=sync

# Realtime (polling for local; reverb for production WebSockets)
REALTIME_DRIVER=polling

# Session
SESSION_ENCRYPT=true

# Registration (beta): set BETA_ACCESS_CODE to require a code for new signups; set REGISTRATION_ENABLED=false to close signups entirely
# REGISTRATION_ENABLED=true
# BETA_ACCESS_CODE=

# Feature: file and folder upload to thoughts
FEATURE_FILE_UPLOAD=false
