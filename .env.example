APP_NAME=IdeaTub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (PostgreSQL with pgvector)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ideatub
DB_USERNAME=
DB_PASSWORD=

# OpenRouter (required for embeddings and metadata extraction; server-only)
OPENROUTER_API_KEY=
# Optional: override embedding/metadata models
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_METADATA_MODEL=openai/gpt-4o-mini

# MCP auth: optional legacy single shared key; prefer per-user keys from ideatub:create-mcp-keys
# MCP_ACCESS_KEY=

# OAuth MCP (ChatGPT connector — "Sign in with IdeaTub")
# OAUTH_MCP_ENABLED=true
# OAUTH_MCP_ISSUER="${APP_URL}"
# OAUTH_MCP_RESOURCE="${APP_URL}/api/mcp"
# Run: php artisan ideatub:oauth-mcp-keys (generates storage/app/oauth-mcp-*.pem)

# Evernote mirror (Phase 3; optional — sync skipped if token empty)
# EVERNOTE_ACCESS_TOKEN=
# Notebook mapping: type/tag → notebook GUID (set only the keys you use)
# EVERNOTE_NOTEBOOK_GUID_DEFAULT=
# EVERNOTE_NOTEBOOK_GUID_IDEA=
# EVERNOTE_NOTEBOOK_GUID_TASK=

# Jira integration (optional): set JIRA_ENABLED=false to hide Jira from the UI and MCP
# JIRA_ENABLED=true
# JIRA_SYNC_DAYS=14
# JIRA_SCHEDULED_SYNC_DAYS=1

# Postmark inbound: webhook URL = {APP_URL}/webhooks/postmark/inbound/{POSTMARK_INBOUND_WEBHOOK_SECRET}
# POSTMARK_INBOUND_WEBHOOK_SECRET=
# Optional: address to show in settings (e.g. capture@in.yourdomain.com)
# POSTMARK_INBOUND_CAPTURE_ADDRESS=
# Optional: log incoming email payloads (sanitized) to storage/logs/laravel.log — set to true to debug, false when done
# POSTMARK_INBOUND_LOG_EMAILS=false

# Fastmail/JMAP mailbox sync
MAIL_SYNC_ENABLED=true
MAIL_SYNC_BACKFILL_BATCH_SIZE=50
MAIL_SYNC_INCREMENTAL_BATCH_SIZE=25

# Queue (sync for no queue; redis when using Evernote sync or other jobs)
QUEUE_CONNECTION=sync

# Realtime (polling for local; reverb for production WebSockets)
REALTIME_DRIVER=polling
